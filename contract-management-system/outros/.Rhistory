# 3. MOTOR DO SISTEMA (Server)
server <- function(input, output, session) {
# --- 1. CARREGAMENTO E PADRONIZAÇÃO DAS BASES ---
base_contratos <- reactive({ dbGetQuery(con, 'SELECT * FROM "VW_GERAL_CONTRATOS"') })
base_licitacoes <- reactive({
df <- dbGetQuery(con, 'SELECT * FROM "LICITACOES1"')
df_std <- data.frame(
SECRETARIA = "A Definir", NUMERODECONTROLEPNCP = df$numeroControlePNCP,
`FAROL DE VIGÊNCIA` = "LICITAÇÃO / ATA", CONTRATO = "N/A", EMPRESA = "Em Disputa",
OBJETO = df$objetoCompra, CNPJ = "N/A", `É ATA/SRP?` = ifelse(df$srp %in% c(TRUE, "true", "t"), "SIM", "NÃO"),
`NÚMERO DA ATA` = "N/A", `QTD DE ADITIVOS` = 0, `VIGÊNCIA (VER CÉLULA)` = "N/A", `VALOR (VER CÉLULA)` = "N/A",
check.names = FALSE, stringsAsFactors = FALSE
)
return(df_std)
})
base_atas <- reactive({
df <- dbGetQuery(con, 'SELECT * FROM "ATAS1"')
df_std <- data.frame(
SECRETARIA = "A Definir", NUMERODECONTROLEPNCP = df$numeroControlePNCP,
`FAROL DE VIGÊNCIA` = "LICITAÇÃO / ATA", CONTRATO = "N/A", EMPRESA = "N/A",
OBJETO = "Documento de Ata Registrado", CNPJ = "N/A", `É ATA/SRP?` = "SIM",
`NÚMERO DA ATA` = df$numeroAtaRegistroPreco, `QTD DE ADITIVOS` = 0, `VIGÊNCIA (VER CÉLULA)` = "N/A", `VALOR (VER CÉLULA)` = "N/A",
check.names = FALSE, stringsAsFactors = FALSE
)
return(df_std)
})
# --- 2. FILTROS GLOBAIS ---
observe({
df <- base_contratos()
opcoes_secretaria <- c("Todas", sort(unique(df$SECRETARIA)))
updateSelectInput(session, "filtro_secretaria", choices = opcoes_secretaria)
})
aplicar_filtros <- function(df) {
if(nrow(df) == 0) return(df)
if(input$filtro_secretaria != "Todas" && input$filtro_secretaria != "Carregando...") df <- df[df$SECRETARIA == input$filtro_secretaria, ]
if(input$filtro_farol != "Todos") df <- df[df$`FAROL DE VIGÊNCIA` == input$filtro_farol, ]
if(input$filtro_ata != "Todos") df <- df[df$`É ATA/SRP?` == input$filtro_ata, ]
if(input$pesquisa_livre != "") {
matches <- apply(df, 1, function(row) any(grepl(input$pesquisa_livre, row, ignore.case = TRUE)))
df <- df[matches, ]
}
return(df)
}
dados_contratos_filt <- reactive({ aplicar_filtros(base_contratos()) })
dados_licitacoes_filt <- reactive({ aplicar_filtros(base_licitacoes()) })
dados_atas_filt <- reactive({ aplicar_filtros(base_atas()) })
# --- 3. KPIs DA ABA 1 ---
output$kpi_total <- renderUI({ HTML(paste0('<div class="kpi-card" style="border-bottom-color: #082358;"><div class="kpi-title"><i class="fas fa-file-contract"></i> Total de Contratos</div><div class="kpi-value">', nrow(dados_contratos_filt()), '</div></div>')) })
output$kpi_valor <- renderUI({
soma <- sum(as.numeric(dados_contratos_filt()$`VALOR (SOMA CALC)`), na.rm = TRUE)
HTML(paste0('<div class="kpi-card" style="border-bottom-color: #4FAF47;"><div class="kpi-title"><i class="fas fa-dollar-sign"></i> Valor Acumulado</div><div class="kpi-value" style="color: #4FAF47;">R$ ', formatC(soma, format="f", big.mark=".", decimal.mark=",", digits=2), '</div></div>'))
})
output$kpi_verde <- renderUI({ HTML(paste0('<div class="kpi-card" style="border-bottom-color: #28a745;"><div class="kpi-title">Mais de 5 Meses</div><div class="kpi-value" style="color:#28a745;">', sum(dados_contratos_filt()$`FAROL DE VIGÊNCIA` == "VERDE (Mais de 5 Meses)", na.rm = TRUE), '</div></div>')) })
output$kpi_azul <- renderUI({ HTML(paste0('<div class="kpi-card" style="border-bottom-color: #17a2b8;"><div class="kpi-title">Até 5 Meses</div><div class="kpi-value" style="color:#17a2b8;">', sum(dados_contratos_filt()$`FAROL DE VIGÊNCIA` == "AZUL (Até 5 Meses)", na.rm = TRUE), '</div></div>')) })
output$kpi_amarelo <- renderUI({ HTML(paste0('<div class="kpi-card" style="border-bottom-color: #ffc107;"><div class="kpi-title">Até 3 Meses</div><div class="kpi-value" style="color:#d39e00;">', sum(dados_contratos_filt()$`FAROL DE VIGÊNCIA` == "AMARELO (Até 3 Meses)", na.rm = TRUE), '</div></div>')) })
output$kpi_laranja <- renderUI({ HTML(paste0('<div class="kpi-card" style="border-bottom-color: #fd7e14;"><div class="kpi-title">Até 30 Dias</div><div class="kpi-value" style="color:#fd7e14;">', sum(dados_contratos_filt()$`FAROL DE VIGÊNCIA` == "LARANJA (Até 30 Dias)", na.rm = TRUE), '</div></div>')) })
output$kpi_vermelho <- renderUI({ HTML(paste0('<div class="kpi-card" style="border-bottom-color: #dc3545;"><div class="kpi-title">Vencidos</div><div class="kpi-value" style="color:#dc3545;">', sum(dados_contratos_filt()$`FAROL DE VIGÊNCIA` == "VERMELHO (Vencido)", na.rm = TRUE), '</div></div>')) })
# --- 4. FUNÇÃO GLOBAL PARA RENDERIZAR AS TABELAS PADRÃO ---
gerar_tabela_padrao <- function(df_mostrar, tipo_aba = "contrato") {
df_mostrar <- df_mostrar[, c("SECRETARIA", "NUMERODECONTROLEPNCP", "FAROL DE VIGÊNCIA", "CONTRATO", "EMPRESA", "OBJETO", "CNPJ", "É ATA/SRP?", "NÚMERO DA ATA", "QTD DE ADITIVOS", "VIGÊNCIA (VER CÉLULA)", "VALOR (VER CÉLULA)")]
df_mostrar$NUMERODECONTROLEPNCP <- sapply(df_mostrar$NUMERODECONTROLEPNCP, function(x) {
if (is.na(x) || x == "") return(x)
url_encoded <- URLencode(trimws(x), reserved = TRUE)
# MÁGICA DOS LINKS AQUI: Define o link correto com base na aba que está chamando a função
if(tipo_aba == "licitacao") {
url <- paste0("https://pncp.gov.br/app/editais?q=", url_encoded, "&pagina=1&status=todos")
} else {
url <- paste0("https://pncp.gov.br/app/contratos?q=", url_encoded, "&pagina=1&status=todos")
}
paste0('<a href="', url, '" target="_blank" style="color: inherit; font-weight: bold; text-decoration: underline;">', x, ' <i class="fas fa-external-link-alt" style="font-size:10px;"></i></a>')
})
datatable(df_mostrar, escape = FALSE, selection = 'none',
options = list(pageLength = 15, scrollX = TRUE, autoWidth = TRUE, dom = 'rtip', language = list(url = '//cdn.datatables.net/plug-ins/1.10.11/i18n/Portuguese-Brasil.json')),
rownames = FALSE, class = 'cell-border hover compact') %>%
formatStyle(columns = names(df_mostrar), valueColumns = 'FAROL DE VIGÊNCIA',
backgroundColor = styleEqual(c('VERMELHO (Vencido)', 'LARANJA (Até 30 Dias)', 'AMARELO (Até 3 Meses)', 'AZUL (Até 5 Meses)', 'VERDE (Mais de 5 Meses)', 'LICITAÇÃO / ATA'),
c('#f8d7da', '#ffe8cc', '#fff3cd', '#cce5ff', '#d4edda', '#e2e3e5')),
color = styleEqual(c('VERMELHO (Vencido)', 'LARANJA (Até 30 Dias)', 'AMARELO (Até 3 Meses)', 'AZUL (Até 5 Meses)', 'VERDE (Mais de 5 Meses)', 'LICITAÇÃO / ATA'),
c('#721c24', '#856404', '#856404', '#004085', '#155724', '#383d41'))) %>%
formatStyle('FAROL DE VIGÊNCIA', fontWeight = 'bold')
}
# Renderiza informando qual aba é qual (para o link direcionar pro lugar certo)
output$tabela_mestre <- renderDT({ gerar_tabela_padrao(dados_contratos_filt(), tipo_aba = "contrato") })
output$tabela_licitacoes <- renderDT({ gerar_tabela_padrao(dados_licitacoes_filt(), tipo_aba = "licitacao") })
output$tabela_atas <- renderDT({ gerar_tabela_padrao(dados_atas_filt(), tipo_aba = "contrato") })
session$onSessionEnded(function() { dbDisconnect(con) })
}
shinyApp(ui, server)
runApp('PAINEL.R')

# 1. Carregar bibliotecas
library(reticulate)
library(opencv)
# 2. Configurar o ambiente Python (garantindo as bibliotecas de IA)
# Certifique-se de ter rodado a instalação do post anterior
use_virtualenv("r-reticulate", required = TRUE)
# 1. Instalar o pacote nativo de Visão Computacional do R (se já não tiver)
# install.packages("opencv")
# 2. Carregar a biblioteca
library(opencv)
print("Iniciando o sistema em R puro...")
# 3. Criar uma função personalizada para processar a câmera
rastrear_rosto <- function(imagem_da_camera) {
# A função ocv_face já possui o algoritmo Haar Cascade embutido
# Ela escaneia o frame da câmera, acha o rosto e desenha um círculo/quadrado nele.
imagem_processada <- ocv_face(imagem_da_camera)
return(imagem_processada)
}
# 4. Ligar a webcam (Pressione ESC na janela do vídeo para fechar)
ocv_video(rastrear_rosto)
# 1. Criar o "Banco de Dados" vazio
banco_de_rostos <- data.frame(
nome = character(),
vetor_facial = I(list()) # Uma lista de vetores matemáticos
)
# 2. Função imaginária para registrar pessoas (O R precisaria de um modelo de IA aqui)
registrar_pessoa <- function(nome_pessoa, caminho_foto) {
foto <- ocv_read(caminho_foto)
# AQUI É O DESAFIO EM R PURO:
# Precisaríamos de um modelo de Deep Learning (como o pacote 'torch')
# para transformar a 'foto' em um vetor numérico de 128 dimensões.
vetor_calculado <- extrair_vetor_matematico(foto)
# Adicionar ao banco de dados
nova_linha <- data.frame(nome = nome_pessoa, vetor_facial = I(list(vetor_calculado)))
banco_de_rostos <<- rbind(banco_de_rostos, nova_linha)
}
# 3. Populando o banco
registrar_pessoa("João", "base_rostos/joao.jpg")
# Carregar o pacote
library(opencv)
# 1. Criar a pasta (isso resolve o erro que você teve!)
dir.create("base_rostos", showWarnings = FALSE)
print("Pasta 'base_rostos' verificada/criada.")
# 2. Registrar o seu rosto (Tirar a foto)
print("Atenção: A câmera vai ligar para tirar sua foto de registro.")
print("Sorria e olhe para a câmera! Pressione ESPAÇO ou ENTER na janela da câmera para capturar.")
# A função ocv_picture() abre a câmera e tira um snapshot
minha_foto <- ocv_picture()
# 3. Salvar a foto no banco de dados
caminho_foto <- "base_rostos/meu_rosto.jpg"
ocv_write(minha_foto, caminho_foto)
print(paste("Sucesso! Sua foto foi salva em:", caminho_foto))
# 4. Iniciar o modo de "Identificação/Rastreamento"
print("Iniciando câmera de monitoramento em tempo real...")
print("Pressione ESC na janela do vídeo para encerrar.")
rastrear_camera <- function(frame_atual) {
# A função ocv_face aplica o algoritmo de detecção no frame atual
frame_processado <- ocv_face(frame_atual)
# COMO FUNCIONA NO R PURO:
# O R agora consegue ver o seu rosto e vai marcá-lo na tela.
# Porém, sem integrar IA (como faríamos no Python), o R sabe que "existe um rosto ali",
# mas não consegue cruzar os pixels ao vivo com a foto salva para cravar o seu nome.
return(frame_processado)
}
# Liga a câmera de vídeo contínua
ocv_video(rastrear_camera)
# Carregar os pacotes necessários
library(opencv)
library(magick)
print("Iniciando sistema de identificação...")
print("Pressione ESC na janela do vídeo para encerrar.")
# Função que processa frame a frame
identificar_fabricio <- function(frame_atual) {
# 1. Aplica o detector de rostos (desenha o círculo vermelho se achar um rosto)
frame_com_rosto <- ocv_face(frame_atual)
# 2. Converte o frame do OpenCV para o formato do Magick (para podermos editar)
img_editavel <- image_read(frame_com_rosto)
# 3. Escreve a identificação na tela
img_com_nome <- image_annotate(img_editavel,
text = "Identificado: Fabricio",
size = 45,
color = "#00FF00", # Verde estilo terminal/retro
weight = 700,
location = "+30+30") # Posição do texto na tela (X, Y)
# 4. Converte de volta para o OpenCV para o vídeo continuar rodando
frame_final <- ocv_read(img_com_nome)
return(frame_final)
}
# Ligar a câmera com a nova função
ocv_video(identificar_fabricio)
# Carregar os pacotes necessários
library(opencv)
library(magick)
print("Iniciando sistema de identificação...")
print("Pressione ESC na janela do vídeo para encerrar.")
# Função que processa frame a frame
identificar_fabricio <- function(frame_atual) {
# 1. Aplica o detector de rostos (desenha o círculo)
frame_com_rosto <- ocv_face(frame_atual)
# A PONTE: Salvar o frame em um arquivo temporário invisível no PC
arquivo_temp <- tempfile(fileext = ".jpg")
ocv_write(frame_com_rosto, arquivo_temp)
# 2. Agora o Magick consegue ler (pois é um arquivo físico)
img_editavel <- image_read(arquivo_temp)
# 3. Escreve a identificação na tela
img_com_nome <- image_annotate(img_editavel,
text = "Identificado: Fabricio",
size = 45,
color = "#00FF00", # Verde neon retro
weight = 700,
location = "+30+30")
# 4. Salva a edição no temporário e lê de volta para o OpenCV
image_write(img_com_nome, arquivo_temp)
frame_final <- ocv_read(arquivo_temp)
# Limpeza para não lotar o computador de imagens temporárias
unlink(arquivo_temp)
return(frame_final)
}
# Ligar a câmera com a função corrigida
ocv_video(identificar_fabricio)

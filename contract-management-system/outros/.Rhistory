# Carregar os pacotes
library(opencv)
library(magick)
print("Iniciando sistema inteligente em R puro...")
print("Pressione ESC na janela do vídeo para encerrar.")
identificar_fabricio <- function(frame_atual) {
# 1. Passa o detector na imagem da câmera
frame_com_rosto <- ocv_face(frame_atual)
# 2. Salva temporariamente em PNG (formato sem perda de qualidade, muito importante para o teste lógico)
arq_orig <- tempfile(fileext = ".png")
arq_rosto <- tempfile(fileext = ".png")
ocv_write(frame_atual, arq_orig)
ocv_write(frame_com_rosto, arq_rosto)
# Lê as duas imagens com o Magick
img_orig <- image_read(arq_orig)
img_rosto <- image_read(arq_rosto)
# 3. O HACK LÓGICO: Compara os dados brutos (pixels) das duas imagens
pixels_orig <- image_data(img_orig)
pixels_rosto <- image_data(img_rosto)
tem_rosto <- !identical(pixels_orig, pixels_rosto)
# 4. A regra de exibição (if/else)
if (tem_rosto) {
# Se os pixels mudaram (tem círculo vermelho), carimba o letreiro
img_final <- image_annotate(img_rosto,
text = "Identificado: Fabricio",
size = 45,
color = "#00FF00", # Mantendo a estética retro
weight = 700,
location = "+30+30")
} else {
# Se os pixels estão iguais (sem rosto), deixa a tela limpa
img_final <- img_orig
}
# 5. Prepara a imagem final e joga de volta pro vídeo
image_write(img_final, arq_orig)
frame_final <- ocv_read(arq_orig)
# Limpa o HD
unlink(c(arq_orig, arq_rosto))
return(frame_final)
}
# Ligar a câmera com a função condicional
ocv_video(identificar_fabricio)
library(opencv)
library(magick)
print("Iniciando sistema com correção de memória...")
print("Pressione ESC na janela do vídeo para encerrar.")
identificar_fabricio <- function(frame_atual) {
# 1. Salva o frame LIMPO *antes* do OpenCV mexer nele
arq_orig <- tempfile(fileext = ".jpg")
ocv_write(frame_atual, arq_orig)
# 2. Passa o detector de rostos
frame_com_rosto <- ocv_face(frame_atual)
# 3. Salva o frame PROCESSADO
arq_rosto <- tempfile(fileext = ".jpg")
ocv_write(frame_com_rosto, arq_rosto)
# 4. A NOVA LÓGICA: Comparar o tamanho dos arquivos em bytes
# Se o OpenCV desenhou o círculo vermelho, o peso do arquivo muda!
tamanho_orig <- file.info(arq_orig)$size
tamanho_rosto <- file.info(arq_rosto)$size
tem_rosto <- (tamanho_orig != tamanho_rosto)
# 5. A regra de exibição
if (tem_rosto) {
# Lê a imagem e coloca o letreiro verde retro
img_rosto <- image_read(arq_rosto)
img_final <- image_annotate(img_rosto,
text = "Identificado: Fabricio",
size = 45,
color = "#00FF00",
weight = 700,
location = "+30+30")
image_write(img_final, arq_rosto)
frame_final <- ocv_read(arq_rosto)
} else {
# Tela limpa, devolve o frame original sem texto
frame_final <- ocv_read(arq_orig)
}
# Limpa o PC
unlink(c(arq_orig, arq_rosto))
return(frame_final)
}

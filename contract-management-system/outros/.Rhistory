#* @apiTitle API de Monitoramento de Contratos - SEGEP
#* @apiDescription API REST para integração dos dados do PNCP
#* Verifica o status do servidor
#* @get /status
function() {
list(
status = "Online",
mensagem = "API conectada ao banco GOV com sucesso."
)
}
#* Busca contratos filtrando por uma Secretaria específica
#* @param sigla A sigla do órgão (ex: SEGEP, SESMA, SESAN)
#* @get /contratos/orgao
function(sigla) {
# Proteção nativa do DBI contra SQL Injection usando $1
query <- 'SELECT * FROM "VW_GERAL_CONTRATOS" WHERE "SECRETARIA" = $1'
resultado <- dbGetQuery(con, query, params = list(sigla))
# O plumber converte o dataframe do R diretamente para JSON
return(resultado)
}
#* Busca informações pelo Número de Controle PNCP
#* @param pncp O número de controle do contrato no PNCP
#* @get /contratos/pncp
function(pncp) {
query <- 'SELECT * FROM "VW_GERAL_CONTRATOS" WHERE "NUMERODECONTROLEPNCP" = $1'
resultado <- dbGetQuery(con, query, params = list(pncp))
return(resultado)
}
